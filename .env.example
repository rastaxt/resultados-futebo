# Token da football-data.org (obrigatório)
FOOTBALL_TOKEN=coloque-seu-token-aqui

# Porta do servidor (opcional, padrão 3000)
PORT=3000

# Senha do painel /admin (opcional).
# Se vazio, uma senha é gerada no primeiro start e impressa no console.
# Quando definida aqui, a troca de senha pelo painel fica desativada.
# ADMIN_SENHA=

# Pasta de dados de estatísticas e senha (opcional, padrão ./dados).
# Em produção aponte para um volume persistente.
# DADOS_DIR=/var/dados/xtscores

# Limite diário total de consultas de cidade/estado (opcional, padrão 3000).
# Use 0 para desativar a estimativa de localização.
# GEO_MAX_DIA=3000

# Limite diário de consultas de cidade/estado por visitante (opcional, padrão 40).
# GEO_MAX_DIA_IP=40

# Limite de requisições por minuto e por IP nas rotas públicas da API (padrão 120; 0 desativa).
# API_MAX_MIN=120

# Confiança nos cabeçalhos X-Real-IP / X-Forwarded-For.
# Sem valor, confia apenas quando a conexão vem de um proxy local (padrão).
# Use 0 quando o Node receber conexões diretas da internet.
# TRUST_PROXY=0
